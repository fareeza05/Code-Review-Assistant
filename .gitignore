# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built by `go test -c`
*.test

# Output of the go coverage tool
*.out

# Go workspace files (Go 1.18+)
*.code-workspace

# Dependency directories (if using vendoring)
vendor/

# Logs and debug stuff
*.log
*.tmp
*.swp

# IDE/editor configs
.vscode/
.idea/
*.iml

# OS-generated files
.DS_Store
Thumbs.db

# Go build output
/bin/
/build/
/dist/

# Ignore local environment or config files
.env
.env.*
